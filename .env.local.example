# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin whitelist
ADMIN_EMAIL=quepiacomunicacion@gmail.com
CONTACT_FORM_TO=quepiacomunicacion@gmail.com

# Optional visual effects (set true to re-enable heavy WebGL backgrounds)
NEXT_PUBLIC_ENABLE_GLASS_BACKGROUND=false
NEXT_PUBLIC_ENABLE_HERO_WEBGL=false

# Marketing analytics
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
NEXT_PUBLIC_GOOGLE_TAG_ID=G-XXXXXXXXXX

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Quepia <notificaciones@quepia.com>"

# Scheduled notifications
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://quepia.com
TASK_NOTIFICATIONS_TIME_ZONE=America/Argentina/Cordoba

# Google Drive backup
GOOGLE_DRIVE_BACKUP_ENABLED=true
GOOGLE_DRIVE_CLIENTES_FOLDER_ID=your-google-drive-clientes-folder-id
# Local development only. In Vercel, prefer GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_BACKUP_TIME_ZONE=America/Argentina/Cordoba

# Google Vertex AI Express Mode (server only)
GOOGLE_VERTEX_API_KEY=your-vertex-api-key

# Zernio social publishing (server only)
ZERNIO_API_KEY=sk_your-zernio-api-key

# Social management webhooks (server only; use different values, >= 32 chars)
ZERNIO_WEBHOOK_SECRET_OPERATIONS=replace-with-a-long-random-operations-secret
ZERNIO_WEBHOOK_SECRET_ANALYTICS=replace-with-a-different-long-random-analytics-secret

# Optional social AI controls. Omit prices to hide cost estimates.
SOCIAL_AI_DAILY_ANALYSES_PER_ADMIN=40
SOCIAL_AI_USD_PER_MTOK_INPUT=
SOCIAL_AI_USD_PER_MTOK_OUTPUT=

# Local tests only. Never set this in production.
# SOCIAL_ZERNIO_API_BASE=http://localhost:54321/zernio/api/v1

# Clave maestra (server only) que cifra las claves privadas de ARCA que se
# cargan en Contabilidad → Facturación. Generala con: openssl rand -base64 32
# Si se pierde o cambia, hay que volver a generar los certificados.
INVOICING_ENCRYPTION_KEY=

# Facturación electrónica ARCA por variables (alternativa anterior a la
# pantalla de configuración; la pantalla tiene prioridad). Sin cualquiera de estas
# variables, emitir queda deshabilitado. Empezá siempre en "test".
# Los PEM pueden ir en una sola línea con "\n" literales.
ARCA_TAX_ID=20123456786
ARCA_ENVIRONMENT=test
ARCA_SALES_POINT=3
# Afirmación legal del emisor: monotributo | exento | no_alcanzado (Factura C).
ARCA_ISSUER_CONDITION=monotributo
ARCA_CERTIFICATE_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
ARCA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Opcional: encabezado del PDF cuando el Padrón de ARCA no trae los datos
# (el de homologación no tiene contribuyentes reales). El Padrón tiene prioridad.
# ARCA_ISSUER_NAME=
# ARCA_ISSUER_ADDRESS=
# ARCA_ISSUER_ACTIVITY_START=2024-03-01
# ARCA_ISSUER_GROSS_INCOME=
# El mismo MCP_RESOURCE_URI del servicio MCP: habilita que el MCP pida emitir.
MCP_RESOURCE_URI=https://mcp.example.com/mcp
