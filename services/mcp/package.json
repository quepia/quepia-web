{
  "name": "@quepia/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/local.ts",
    "start": "node --env-file-if-exists=.env dist/local.js",
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vercel:dev": "npx --yes vercel@57.0.0 dev",
    "vercel:build": "npx --yes vercel@57.0.0 build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@supabase/supabase-js": "2.110.8",
    "express": "5.2.1",
    "jose": "6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
