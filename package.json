{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-static.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "mcp:verify": "node scripts/verify-mcp-boundaries.mjs",
    "mcp:sql:verify": "node scripts/verify-mcp-sql-syntax.mjs",
    "mcp:test": "npm --prefix services/mcp test",
    "mcp:build": "npm --prefix services/mcp run compile",
    "mcp:web:test": "node --test lib/mcp/*.test.mjs",
    "security:test": "node --test lib/security/*.test.mjs supabase/tests/security/*.test.mjs",
    "ai:vertex:test": "node --env-file=.env.local scripts/test-vertex-ai.mjs",
    "accounting:verify": "node scripts/verify-accounting-integrity.mjs",
    "invoicing:test": "node --test supabase/tests/invoicing/*.test.mjs",
    "drive:backfill": "node scripts/backfill-google-drive-backup.mjs",
    "drive:ensure-folders": "node scripts/ensure-google-drive-client-folders.mjs",
    "portfolio:download": "node scripts/myportfolio-bulk-download.mjs",
    "portfolio:catalog": "node scripts/portfolio-import.mjs",
    "portfolio:import": "node scripts/portfolio-import.mjs --execute",
    "drive:monthly": "node scripts/monthly-backups.mjs",
    "drive:monthly:test": "node --test lib/sistema/monthly-backups.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.16",
    "@react-email/components": "^1.0.6",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/three": "^0.182.0",
    "ai": "^7.0.22",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "facturas": "0.20.0",
    "ffmpeg-static": "^5.3.0",
    "fontkit": "2.0.4",
    "framer-motion": "^12.27.1",
    "konva": "^10.2.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.26",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.1",
    "resend": "^6.18.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "use-image": "^1.1.4",
    "usehooks-ts": "^3.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/eslint-plugin-next": "15.5.26",
    "@types/archiver": "^6.0.4",
    "@types/fontkit": "2.0.8",
    "@types/node": "^22",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.26",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.7.0",
    "plpgsql-parser": "18.2.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ],
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "fflate@>=0.6.0 <0.6.11": "0.6.11"
    }
  },
  "overrides": {
    "postcss@<8.5.23": "8.5.23",
    "nanoid@>=3.0.0 <3.3.18": "3.3.18",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "fflate@>=0.6.0 <0.6.11": "0.6.11"
  }
}
